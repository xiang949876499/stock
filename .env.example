# 应用配置
APP_NAME=Stock Hub
APP_VERSION=0.1.0
DEBUG=true

# 数据目录
DATA_DIR=./data
LOG_DIR=./logs

# AI 模型
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4
AI_BASE_URL=

# TradingAgents 稳定性配置（可选）
# 降低轮数和分析师数量可以减少外部 LLM/API 调用次数，提升成功率
TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_LLM_BACKEND_URL=
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_SELECTED_ANALYSTS=market,news
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_MAX_ATTEMPTS=2
TRADINGAGENTS_RETRY_BACKOFF_SECONDS=2

# 数据源（多数据源用逗号分隔，按优先级从左到右 fallback）
# 可选: akshare / tushare / yfinance / ashare_skill / westock
DATA_PROVIDER=akshare,tushare,yfinance
TUSHARE_TOKEN=

# 通知
WECHAT_WEBHOOK=
FEISHU_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=

# 执行
GATEWAY_TYPE=sim
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=

# 风控
MAX_POSITION_RATIO=0.3
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.1
