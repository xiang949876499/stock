# 应用配置
APP_NAME=Stock Hub
APP_VERSION=0.1.0
DEBUG=true

# 数据目录
DATA_DIR=./data
LOG_DIR=./logs

# AI 模型
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4
AI_BASE_URL=

# 数据源（多数据源用逗号分隔，按优先级从左到右 fallback）
# 可选: akshare / tushare / yfinance / ashare_skill / westock
DATA_PROVIDER=akshare,tushare,yfinance
TUSHARE_TOKEN=

# 通知
WECHAT_WEBHOOK=
FEISHU_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=

# 执行
GATEWAY_TYPE=sim
CTP_BROKER_ID=
CTP_USER_ID=
CTP_PASSWORD=

# 风控
MAX_POSITION_RATIO=0.3
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.1
